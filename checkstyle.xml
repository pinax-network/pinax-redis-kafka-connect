<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Intentionally lenient: this enforces import hygiene and a handful of
  high-value correctness checks, not full formatting/Javadoc style. The goal is
  to catch real mistakes (unused/star imports, fall-through, empty blocks)
  without drowning a small codebase in nits.
-->
<module name="Checker">
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <!-- No tabs. -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="LineLength">
    <property name="max" value="160"/>
    <property name="ignorePattern" value="^\s*//|^import"/>
  </module>

  <module name="TreeWalker">
    <!-- Imports -->
    <module name="AvoidStarImport">
      <!-- Allow `import static ...*` for test assertion/Mockito helpers. -->
      <property name="allowStaticMemberImports" value="true"/>
    </module>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>

    <!-- Correctness / readability -->
    <module name="NeedBraces"/>
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="UpperEll"/>
    <module name="ModifierOrder"/>
    <module name="OneStatementPerLine"/>
    <module name="FallThrough"/>
    <module name="DefaultComesLast"/>
    <module name="EmptyBlock">
      <property name="option" value="text"/>
      <property name="tokens" value="LITERAL_CATCH"/>
    </module>
  </module>
</module>
